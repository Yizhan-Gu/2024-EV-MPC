.DS_Store
.venv/
__pycache__/
*.py[cod]

# Local research datasets. Keep compact experiment summaries under
# experiments/results/ tracked, but never upload source/session tables.
data/raw/**
data/processed/*.csv
archive/legacy_2024/data/**

# Large or noisy historical provenance retained locally only.
archive/legacy_2024/development_history/**
archive/legacy_2024/results/**
archive/unvalidated_2026_copilot_pipeline/pipeline/figures/**
archive/unvalidated_2026_copilot_pipeline/pipeline/models/**
archive/unvalidated_2026_copilot_pipeline/pipeline/tables/**
archive/unvalidated_2026_copilot_pipeline/pipeline/optimization_results.csv
archive/paper_development_runs/**
!archive/paper_development_runs/NOTICE.md

# Generated LaTeX and visual-QA intermediates. Keep the final PDF.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
tmp/**

# Local editor/session state.
.Rhistory
*.history
