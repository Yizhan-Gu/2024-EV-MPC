install.packages("biscale")
####load packages and clear workspace####
rm(list = ls(all = TRUE))
libs <- c("tidyverse", "ggthemes", "gdata", "reshape2", "RColorBrewer", "lubridate", "hms", "cowplot", "gridExtra", "factoextra", "NbClust", "dtwclust", "cluster","BBmisc", "clValid", "fpc", "xts", "readxl", "patchwork")
invisible(lapply(libs, library, character.only = TRUE))
# Custom plotting theme
plot.size = 7; line.size = 0.05; point.size = 0.4; legend.size = 0.4; text.size = 1.5
#################################################################################
dir <- "/Users/admin/Desktop/EV_program/2023Fall_TotalEnergies"
setwd(dir)
#Maybe rename station file?
raw_data <- read_csv("/Users/admin/Desktop/EV_program/Other/SD_County_Comparison_Chademo_CCS/SD_latest_original_sessions.csv")
stations <- read.csv("/Users/admin/Desktop/EV_program/Other/SD_County_Comparison_Chademo_CCS/Station_Table_modified_2.csv")
UCSD_noDCFC_stations <- stations %>%
filter(Max_Power <= 40) %>%
filter(grepl("UCSD", Station_Name, ignore.case = TRUE)) %>%
select(Station_Name, Max_Power)
#TODO: This part has been added for /Users/admin/Desktop/EV_program/2024Summer_EVResearch/MPC.jl, changing the time setting
# Convert the UTC datetime columns to POSIXct objects
raw_data$session_start_time_utc <- ymd_hms(raw_data$session_start_time_utc)
raw_data$session_end_time_utc <- ymd_hms(raw_data$session_end_time_utc)
# Convert UTC to Los Angeles time considering DST
raw_data$session_start_time_la <- with_tz(raw_data$session_start_time_utc, tzone = "America/Los_Angeles")
raw_data$session_end_time_la <- with_tz(raw_data$session_end_time_utc, tzone = "America/Los_Angeles")
# data <- read_csv("data_sessions.csv")
data <- raw_data %>%
select(driver_id, session_start_time_la, session_end_time_la, total_energy_dispensed, charging_time_secs, station_name, vehicle_make, vehicle_model, vehicle_battery_capacity) %>%
filter(#driver_id %in% Driver_id,
complete.cases(.),
total_energy_dispensed >= 1,
total_energy_dispensed <= 1.05 * vehicle_battery_capacity,
#year(session_start_time_utc) == 2022,
#(session_end_time_utc - session_start_time_utc) >= minutes(10),
difftime(session_end_time_la, session_start_time_la, units = "mins") >= 10,
date(session_start_time_la) == date(session_end_time_la), # filter out overnight charging updated for /Users/admin/Desktop/EV_program/2024Summer_EVResearch/MPC.jl
station_name %in% UCSD_noDCFC_stations$Station_Name) %>%
group_by(driver_id) %>%
filter(n() > 50) %>%
ungroup()
# Convert UTC to PST Time
current_date <- as.Date("2023-11-01")
current_date <- as.POSIXct(paste(current_date, "00:00:00"), tz = "America/Los_Angeles")
View(data)
data$Time_of_day <- as.POSIXct(paste(current_date, format(data$session_start_time_la, format = "%H:%M:%S"), format = "%H:%M:%S"), tz = "America/Los_Angeles")
hist(data$Time_of_day)
View(data)
data$Hour_of_day <- as.numeric(format(data$session_start_time_la, "%H"))
# Create the histogram
hist(data$Hour_of_day, main = "Histogram of Hours of the Day", xlab = "Hour of Day")
data$Hour_of_day_AT <- as.numeric(format(data$session_start_time_la, "%H"))
data$Hour_of_day_DT <- as.numeric(format(data$session_end_time_la, "%H"))
hist(data$Hour_of_day_AT, main = "AT of Hours of the Day", xlab = "Hour of Day")
hist(data$Hour_of_day_DT, main = "DT of Hours of the Day", xlab = "Hour of Day")
# data <- read_csv("data_sessions.csv")
data <- raw_data %>%
select(driver_id, session_start_time_la, session_end_time_la, total_energy_dispensed, charging_time_secs, station_name, vehicle_make, vehicle_model, vehicle_battery_capacity) %>%
filter(#driver_id %in% Driver_id,
complete.cases(.),
total_energy_dispensed >= 1,
total_energy_dispensed <= 1.05 * vehicle_battery_capacity,
#year(session_start_time_utc) == 2022,
#(session_end_time_utc - session_start_time_utc) >= minutes(10),
difftime(session_end_time_la, session_start_time_la, units = "mins") >= 10,
date(session_start_time_la) == date(session_end_time_la), # filter out overnight charging updated for /Users/admin/Desktop/EV_program/2024Summer_EVResearch/MPC.jl
station_name %in% UCSD_noDCFC_stations$Station_Name) %>%
group_by(driver_id) %>%
filter(n() > 50) %>%
ungroup()
####Compute flexible sessions####
data$charging_end_time_la <- data$charging_time_secs + data$session_start_time_la
write_csv(data, "/Users/admin/Desktop/EV_program/2024Summer_EVResearch/clean_charging_sessions.csv")
data$Hour_of_day_AT <- as.numeric(format(data$session_start_time_la, "%H"))
data$Hour_of_day_DT <- as.numeric(format(data$session_end_time_la, "%H"))
hist(data$Hour_of_day_AT, main = "AT of Hours of the Day", xlab = "Hour of Day")
hist(data$Hour_of_day_DT, main = "DT of Hours of the Day", xlab = "Hour of Day")
